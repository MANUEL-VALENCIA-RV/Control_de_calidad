# NestJS / Render
PORT=3001

# Debe ser EXACTAMENTE el mismo secreto usado por Next.js para firmar cc_session.
AUTH_SECRET=pon_aqui_un_secreto_largo_y_seguro

# Neon / PostgreSQL
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST/DB?sslmode=require

# Frontend permitido. Puedes separar varios orígenes con coma.
CORS_ORIGINS=http://localhost:3000,https://control-de-calidad-calidad-next.vercel.app

# Google Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Debe coincidir con el redirect URI autorizado en Google Cloud.
# Para ejecutar scripts/get-refresh-token.mjs localmente:
GOOGLE_REDIRECT_URI=http://localhost:8080
